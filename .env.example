# Copy to .env. POSTGRES_PASSWORD and PUBLIC_BASE_URL must be set for each installation.

# Image tag built/loaded on this server (see `make bundle`).
APP_VERSION=dev
# "production" (default) or "dev". Dev enables /api/docs, which loads Swagger UI from a CDN.
APP_ENV=production
HTTP_PORT=80

# Database. Use a unique random hex password (at least 48 characters).
POSTGRES_DB=academy
POSTGRES_USER=academy
POSTGRES_PASSWORD=

# Address users type in the browser; used in certificate QR codes (verification page).
PUBLIC_BASE_URL=http://academy.bank.local
APP_TIMEZONE=Asia/Tashkent

# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

API_WORKERS=4

# Comma-separated keys accepted by GET /api/v1/certification-status (X-API-Key header).
CERT_STATUS_API_KEYS=

# Signatory name printed on certificates, above "Kompetensiyalar markazi rahbari".
CERT_SIGNATORY_NAME=

# AI question drafting (methodologists only; drafts are always reviewed by a person).
# This is the platform's only outbound call: the worker sends lesson transcripts (and
# optional reference PDFs) to api.anthropic.com. Leave empty to hide the feature;
# set it only if the bank allows that egress for synthetic/test content.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
